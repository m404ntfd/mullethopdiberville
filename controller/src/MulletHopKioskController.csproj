<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MulletHopKioskController</AssemblyName>
    <RootNamespace>MulletHopKioskController</RootNamespace>
    <AssemblyTitle>Mullet Hop Systems Controller</AssemblyTitle>
    <ApplicationIcon>..\..\assets\MulletHopFish.ico</ApplicationIcon>
    <Version>1.13.0</Version>
    <Authors>Mullet Hop</Authors>
    <Product>Mullet Hop Systems Controller</Product>
    <Description>Local-network dashboard for Mullet Hop waiver kiosks and POS workstations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\KioskDiscoveryProtocol.cs"
             Link="KioskDiscoveryProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\MulletHopFish.png"
                      LogicalName="MulletHopKioskController.Assets.MulletHopFish.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(UpdateRepositoryUrl)' != ''">
    <AssemblyMetadata Include="UpdateRepositoryUrl" Value="$(UpdateRepositoryUrl)" />
  </ItemGroup>
</Project>
