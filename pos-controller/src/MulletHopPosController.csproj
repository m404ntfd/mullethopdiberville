<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MulletHopPosController</AssemblyName>
    <RootNamespace>MulletHopPosController</RootNamespace>
    <AssemblyTitle>Mullet Hop POS</AssemblyTitle>
    <ApplicationIcon>..\..\assets\MulletHopStatusViewerFish.ico</ApplicationIcon>
    <Version>1.7.2</Version>
    <Authors>Mullet Hop</Authors>
    <Product>Mullet Hop POS</Product>
    <Description>Full-screen LilyPad POS and front-desk controls for Mullet Hop waiver kiosks.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\MulletHopStatusViewerFish.png"
                      LogicalName="MulletHopPosController.Assets.MulletHopStatusViewerFish.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(UpdateRepositoryUrl)' != ''">
    <AssemblyMetadata Include="UpdateRepositoryUrl" Value="$(UpdateRepositoryUrl)" />
  </ItemGroup>
</Project>
